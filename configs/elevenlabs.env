# ElevenLabs Config for the blueprint.
# Runs ElevenLabs dubbing
NVIDIA_VISIBLE_DEVICES=all

# Shared Timeouts (used by both Controller and S2S services)
HEALTH_CHECK_TIMEOUT=5.0
BUFFER_POLL_TIMEOUT=0.1

# S2S Defaults
S2S_SERVICE="EL_DUBBING"
S2S_GRPC_API_PORT=50050
S2S_MAX_CONCURRENCY=1
S2S_LOG_LEVEL="INFO"
S2S_DEFAULT_SOURCE_LANGUAGE=auto # Auto detects the source language (ElevenLabs)
S2S_DEFAULT_TARGET_LANGUAGE=de
S2S_SAMPLE_RATE_HZ=16000
S2S_MESSAGE_SIZE=67108864
S2S_GRPC_CONCURRENCY_MODE=threading
S2S_GRPC_THREADS_PER_PROCESS=1
S2S_EL_DUBBING_POLL_INTERVAL=10
S2S_EL_DUBBING_MAX_ATTEMPTS=120
S2S_EL_KEEPALIVE_INTERVAL=1

# ELEVENLABS
# ELEVENLABS_API_KEY should be set in your environment or passed via command line.

# LipSync NIM
LIPSYNC_IMAGE=nvcr.io/nim/nvidia/lipsync:1.3.0
LIPSYNC_NIM_TAGS_SELECTOR="language=de"
LIPSYNC_NIM_HTTP_API_PORT=8004
LIPSYNC_NIM_GRPC_API_PORT=50054
LIPSYNC_LOG_LEVEL="INFO"
LIPSYNC_DEBUG_MODE=0
NV_AI4M_LS_INPUT_QUEUE_TIMEOUT_S=5
LIPSYNC_MODEL_MOUNT_PATH=./volumes/models/lipsync

# ASD NIM (Active Speaker Detection)
ASD_IMAGE=nvcr.io/nim/nvidia/active-speaker-detection:1.1.0
ASD_GRPC_API_PORT=50055
ASD_NIM_HTTP_API_PORT=8005
ASD_LOG_LEVEL="INFO"
ASD_MODEL_MOUNT_PATH=./volumes/models/asd
ASD_DIARIZATION_TOLERANCE_MS=0

# Controller Service
CONTROLLER_GRPC_API_PORT=50056
CONTROLLER_MAX_CONCURRENCY=1
CONTROLLER_GRPC_THREADS_PER_PROCESS=1
CONTROLLER_LOG_LEVEL="INFO"
CONTROLLER_GRPC_CONCURRENCY_MODE=threading

# Controller DEBUG Port
CONTROLLER_DEBUG_PORT=5678
CONTROLLER_VS_CODE_DEBUG=0

# Controller Service Options
CONTROLLER_CONFIG_POLL_TIMEOUT=5.0
CONTROLLER_CLEANUP_TIMEOUT=10.0

# Optional TLS for controller -> NIM channels. Plaintext by default inside
# the compose network; uncomment for deployments crossing untrusted networks
# (see docs/source/configuration.rst).
# CONTROLLER_NIM_SSL_MODE=TLS
# CONTROLLER_NIM_SSL_KEY=/certs/client.key
# CONTROLLER_NIM_SSL_CERT=/certs/client.pem
# CONTROLLER_NIM_SSL_ROOT_CERT=/certs/root.pem
# Per-hop overrides of CONTROLLER_NIM_SSL_MODE (empty inherits the global
# mode). Keep a hop DISABLED when its server runs plaintext (the in-repo
# S2S serves TLS only when started with --use-ssl; the NIM images expose
# no TLS surface).
# CONTROLLER_S2S_SSL_MODE=DISABLED
# CONTROLLER_ASD_SSL_MODE=TLS
# CONTROLLER_LIPSYNC_SSL_MODE=TLS

# Reference App
REFERENCE_APP_LOG_LEVEL="INFO"
DEFAULT_INPUT_FILE_NAME="sample_video.mp4"
REFERENCE_APP_ENABLE_PREPROCESSING=true
